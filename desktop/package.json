{
  "name": "lapbook-desktop",
  "productName": "Lapbook",
  "version": "2.1.0",
  "description": "Lapbook for Windows: logs your F1 25 laps automatically from the game's UDP telemetry.",
  "main": "boot.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/f1-25.test.js test/updates.test.js test/ac.test.js test/forza.test.js test/delta.test.js test/acc.test.js test/lmu.test.js test/pc2.test.js",
    "dist": "electron-builder --win --x64 --publish never",
    "update": "node tools/make-update.js"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "app.lapbook.desktop",
    "productName": "Lapbook",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "boot.js",
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "f1-25.js",
      "ac.js",
      "acnames.js",
      "forza.js",
      "acc.js",
      "lmu.js",
      "pc2.js",
      "delta.js",
      "updates.js",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "Lapbook-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lapbook",
      "artifactName": "Lapbook-Setup-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": "lapbook-update",
        "name": "Lapbook update",
        "description": "Lapbook update package",
        "role": "Viewer"
      }
    ]
  }
}
